# ╔═══════════════════════════════════════════════════════════════════════╗
# ║  MODELLO — questo file sta nel repo e contiene solo NOMI, mai valori. ║
# ║                                                                       ║
# ║  Su un computer nuovo:  cp .env.example .env.local                    ║
# ║  poi si riempie .env.local, che git ignora.                           ║
# ║                                                                       ║
# ║  ⚠️ Non incollare MAI una chiave vera qui dentro: questo file finisce  ║
# ║     su GitHub. Vedi docs/CHIAVI.md.                                   ║
# ╚═══════════════════════════════════════════════════════════════════════╝

# ═══════════════════════════════════════════════════════════════════════
# BLOCCO 1 — SERVE ADESSO. Senza queste la Fase 1 non si chiude.
# ═══════════════════════════════════════════════════════════════════════

# ─── Il cervello ────────────────────────────────────────────────────────
# La chiave di OpenRouter: una sola chiave per tutti i modelli di testo.
# È l'unica cosa che blocca sei righe del PERCORSO (3, 4, 5, 6, 7, 8).
# Forma: sk-or-v1-...
# Tutorial: docs/SETUP-OPENROUTER.md
OPENROUTER_API_KEY=

# ─── Il database (Neon) ─────────────────────────────────────────────────
# Tre stringhe di connessione, tre poteri diversi. Non è pignoleria: se
# l'applicazione girasse col ruolo padrone, un errore in una query potrebbe
# cancellare tabelle. Così il massimo danno possibile è limitato.
#
#   DATABASE_URL          nexus_app     — quello che usa il sito. Rispetta le
#                                         regole per riga (RLS): ogni utente
#                                         vede solo la sua roba.
#   DATABASE_URL_OWNER    neondb_owner  — solo per le migrazioni (npm run db:apply)
#   ANALYST_DATABASE_URL  nexus_analyst — sola lettura, per guardare i numeri
#
# Le ultime due si rigenerano da sole: npm run db:role e npm run db:analyst
# Tutorial: docs/SETUP-DATABASE.md
DATABASE_URL=
DATABASE_URL_OWNER=
ANALYST_DATABASE_URL=

# ─── Gli accessi (Better Auth + Google) ─────────────────────────────────
# BETTER_AUTH_SECRET non si compra: è una frase casuale che firma i cookie.
# Te la generi tu: npx @better-auth/cli@latest secret
# Se la cambi, l'unico effetto è che tutti devono rifare l'accesso.
BETTER_AUTH_SECRET=

# L'indirizzo da cui gira il sito. In locale resta così com'è.
# Sul pannello di Vercel diventa il dominio vero (https://corpagent.app).
BETTER_AUTH_URL=http://localhost:5173

# Il pulsante "Entra con Google". Gratis.
# Tutorial: docs/SETUP-ACCESSI.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── La verifica anti-bot (Cloudflare Turnstile) ────────────────────────
# Gratis, illimitato. È la riga 10 della Fase 1, l'ultima che manca.
# ⚠️ VITE_TURNSTILE_SITE_KEY ha il prefisso VITE_ perché è PROGETTATA per
#    essere pubblica e arrivare al browser. La SECRET no: quella resta qui.
#    Non mettere mai VITE_ davanti a una chiave segreta: equivale a pubblicarla.
# Tutorial: docs/SETUP-CHIAVI-MANCANTI.md § Turnstile
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Login con Apple (facoltativo) ──────────────────────────────────────
# Richiede l'account sviluppatore Apple: 99 €/anno. Lasciate vuote non si
# rompe niente — compare solo il pulsante Google.
# ⚠️ APPLE_CLIENT_SECRET non è una password: è un token JWT che SCADE ogni
#    6 mesi e va rigenerato. Dettagli nel tutorial.
# Tutorial: docs/SETUP-CHIAVI-MANCANTI.md § Apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=


# ═══════════════════════════════════════════════════════════════════════
# BLOCCO 2 — FASE 2: la memoria (RAG). Non ancora.
# ═══════════════════════════════════════════════════════════════════════

# OpenRouter serve i modelli di chat, non quelli di ricerca semantica: per
# trasformare i documenti in numeri ("embedding") serve OpenAI a parte.
# Costa pochissimo: ~0,02 $ per un milione di parole indicizzate.
# Tutorial: docs/SETUP-CHIAVI-MANCANTI.md § OpenAI
OPENAI_API_KEY=


# ═══════════════════════════════════════════════════════════════════════
# BLOCCO 3 — FASE 3: WhatsApp, il canale. Non ancora.
# ═══════════════════════════════════════════════════════════════════════

# Tutte e sei vengono dalla STESSA app su developers.facebook.com.
# La verifica del Business Manager può richiedere giorni: quando ti avvicini
# alla Fase 3, inizia la pratica con una settimana di anticipo.
# Tutorial: docs/SETUP-WHATSAPP.md

# L'app Meta. Servono anche a Messenger e Instagram, più avanti.
META_APP_ID=
# ⚠️ Con questo si verifica la FIRMA dei webhook in arrivo. Senza, chiunque
#    conosca il tuo indirizzo può fingersi Meta e far scrivere il tuo agente.
META_APP_SECRET=

# Il token permanente dell'utente di sistema (non quello temporaneo da 24 ore).
WHATSAPP_TOKEN=
# L'identificativo del numero di telefono, non il numero.
WHATSAPP_PHONE_ID=
# L'identificativo dell'account WhatsApp Business: serve per i modelli di
# messaggio approvati da Meta.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Questa la INVENTI tu: una parola d'ordine qualsiasi. Meta te la rimanda
# indietro quando collega il webhook, e noi controlliamo che combaci.
WHATSAPP_VERIFY_TOKEN=


# ═══════════════════════════════════════════════════════════════════════
# BLOCCO 4 — FASE 4: incassare (Stripe). Non ancora.
# ═══════════════════════════════════════════════════════════════════════

# Serve la partita IVA per l'account business italiano.
# Si lavora prima in modalità test (chiavi sk_test_ / pk_test_), poi si passa
# alle chiavi live. Tutorial: docs/SETUP-CHIAVI-MANCANTI.md § Stripe
STRIPE_SECRET_KEY=
# Pubblica per definizione: è quella che il browser usa per aprire il pagamento.
VITE_STRIPE_PUBLISHABLE_KEY=
# Firma i webhook: è così che sappiamo che un pagamento è andato a buon fine
# davvero, e non che qualcuno ce lo sta raccontando.
STRIPE_WEBHOOK_SECRET=


# ═══════════════════════════════════════════════════════════════════════
# BLOCCO 5 — FASE 6: i connettori. NON RIEMPIRE ADESSO.
# ═══════════════════════════════════════════════════════════════════════
#
# Questo blocco è qui perché tu abbia la mappa completa, non perché vada
# compilato. La regola d'oro dice: se non aiuta a vendere entro Dicembre
# 2026, si taglia. In V1 esiste un solo canale, WhatsApp.
#
# ⚠️ LEGGI PRIMA docs/SETUP-CONNETTORI.md. C'è una cosa che cambia tutto:
#    queste NON sono le chiavi dei tuoi clienti. Sono le credenziali della
#    TUA applicazione presso Google, Slack, Shopify. Il Gmail del singolo
#    ristoratore non entra mai in questo file: entra nel database, cifrato.
#    Un file .env non può contenere le credenziali di mille clienti diversi.

# La chiave con cui si cifrano i token dei clienti prima di salvarli nel
# database. Te la generi tu, come BETTER_AUTH_SECRET:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠️ Se la perdi, tutti i clienti devono ricollegare tutti i loro account.
CONNECTOR_ENCRYPTION_KEY=

# ─── Ondata 1: Google (Gmail, Calendar, Drive/Sheets) ───────────────────
# Nessuna variabile nuova: si riusano GOOGLE_CLIENT_ID e GOOGLE_CLIENT_SECRET
# del Blocco 1. Cambia solo la lista dei permessi richiesti (gli "scope").

# ─── Ondata 2: e-commerce e pagamenti ───────────────────────────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# WooCommerce non ha credenziali globali: ogni negozio genera le sue e le
# incolla nel pannello. Finiscono nel database, non qui.

# ─── Ondata 3: gli altri canali di messaggistica ────────────────────────
# Telegram è il più semplice del mondo: si chiede a un bot, @BotFather.
TELEGRAM_BOT_TOKEN=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Teams e Outlook: stessa app registrata su Azure (Microsoft Entra ID).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Instagram Direct e Messenger: nessuna variabile nuova, si riusano
# META_APP_ID e META_APP_SECRET del Blocco 3.

# ─── Ondata 4: documenti, tabelle e CRM ─────────────────────────────────
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=

HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# ─── Ondata 5: amministrazione italiana ─────────────────────────────────
FATTURE_IN_CLOUD_CLIENT_ID=
FATTURE_IN_CLOUD_CLIENT_SECRET=
# La verifica delle partite IVA europee (VIES) è un servizio pubblico
# gratuito dell'Unione Europea: nessuna chiave, nessuna registrazione.


# ═══════════════════════════════════════════════════════════════════════
# BLOCCO 6 — FASE 8: voce e immagini. Molto dopo il lancio.
# ═══════════════════════════════════════════════════════════════════════

# La bibbia esclude esplicitamente la voce dalla V1. Questa riga è qui solo
# perché tu abbia un posto dove metterla il giorno che servirà.
ELEVENLABS_API_KEY=

# ── Il riepilogo serale (Fase 3, riga 27) ────────────────────────────────
# Vercel firma le chiamate programmate con `Authorization: Bearer $CRON_SECRET`.
# Serve perche' l'indirizzo del riepilogo e' pubblico come tutti gli altri: il
# segreto sta qui, non nel percorso scritto in vercel.json (che e' versionato).
# Generane uno a caso:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
