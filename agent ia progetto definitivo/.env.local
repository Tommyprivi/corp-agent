# ─── LE TUE CHIAVI: incollale qui ───────────────────────────────────────

# OpenRouter — da openrouter.ai/keys. Serve ADESSO (Fase 1, riga 3).
OPENROUTER_API_KEY=

# OpenAI / ChatGPT — serve alla Fase 2, per cercare dentro i documenti.
# ⚠️ Se è quella vecchia già passata in chat, rigenerala prima: è compromessa.
OPENAI_API_KEY=

# Stripe — serve alla Fase 4, quando si incassa.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ElevenLabs — serve alla Fase 8, la voce. Puoi lasciarla vuota per mesi.
# ⚠️ Se è quella vecchia già passata in chat, rigenerala prima: è compromessa.
ELEVENLABS_API_KEY=


# ─── QUESTE TRE MANCANO PER FAR PARTIRE LA FASE 1 ───────────────────────

# Neon: la stringa di connessione del database. Vedi docs/SETUP-DATABASE.md.
# Forma: postgresql://nexus_app:password@ep-...-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://nexus_app:a2db00dfc4bf4edeec4d730b643cc80f80e971a6da0cc8d7@ep-floral-sound-ascreo1j-pooler.c-4.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Firma dei cookie di sessione. NON è una chiave da comprare: te la generi tu.
# Incolla nel terminale questo comando e metti qui il risultato:
#   npx @better-auth/cli@latest secret
BETTER_AUTH_SECRET=1ef40a642d0b9f19b42f7d3d6d1431175ffb4c929ba167e55d29ace4d192d916

# Login con Google. Vedi docs/SETUP-ACCESSI.md per come ottenerle.
GOOGLE_CLIENT_ID=293163593292-oluliqbhb7mgg0e220hk8u8ljujgcj55.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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


# ─── Da lasciare così ───────────────────────────────────────────────────

# L'indirizzo del sito in locale. Sul sito pubblicato diventa il dominio vero.
BETTER_AUTH_URL=http://localhost:5173


# ─── Puoi ignorarle finché non arriviamo là ─────────────────────────────

# Apple: richiede l'account sviluppatore da 99 €/anno. Vuote = solo pulsante Google.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Cloudflare Turnstile, la verifica anti-bot (gratis). Fase 1, riga 10.
